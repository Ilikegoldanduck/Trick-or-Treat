function init(self)
	gui.animate(gui.get_node("cup1"), "position", vmath.vector3(280, 300, 0), gui.EASING_LINEAR, 3, 0, nil, gui.PLAYBACK_ONCE_PINGPONG)
	gui.animate(gui.get_node("cup2"), "position", vmath.vector3(480, 300, 0), gui.EASING_LINEAR, 3, 0, nil, gui.PLAYBACK_ONCE_PINGPONG)
	gui.animate(gui.get_node("cup3"), "position", vmath.vector3(680, 300, 0), gui.EASING_LINEAR, 3, 0, nil, gui.PLAYBACK_ONCE_PINGPONG)
	timer.delay(3, false, function()
		gui.set_visible(gui.get_node("ball"), false)
		spin()
		timer.delay(.5, false, function()
			msg.post(".", "acquire_input_focus")
		end)
	end)
end

function spin()
	gui.animate(gui.get_node("cup1"), "position", vmath.vector3(680, 200, 0), gui.EASING_LINEAR, .5, 0, nil, gui.PLAYBACK_ONCE_PINGPONG)
	gui.animate(gui.get_node("cup2"), "position", vmath.vector3(680, 200, 0), gui.EASING_LINEAR, .125, 0, function()
		gui.animate(gui.get_node("cup2"), "position", vmath.vector3(280, 200, 0), gui.EASING_LINEAR, .25, 0, function()
			gui.animate(gui.get_node("cup2"), "position", vmath.vector3(480, 200, 0), gui.EASING_LINEAR, .125, 0, function()
				
			end)
		end)
	end)
	gui.animate(gui.get_node("cup3"), "position", vmath.vector3(280, 200, 0), gui.EASING_LINEAR, .5, 0, nil, gui.PLAYBACK_ONCE_PINGPONG)
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

local cupTable = {
	"cup1",
	"cup2",
	"cup3"
}

function on_message(self, message_id, message, sender)
	
end

function on_input(self, action_id, action)
	for i, v in ipairs(cupTable) do
		if gui.pick_node(gui.get_node(v), action.x, action.y) then
			if action_id == hash("touch") and action.pressed then
				msg.post(".", "release_input_focus")
				if i == 1 then
					gui.set(gui.get_node("ball"), "position", vmath.vector3(480, 200, 0))
				elseif i == 2 then
					gui.set(gui.get_node("ball"), "position", vmath.vector3(680, 200, 0))
				else
					gui.set(gui.get_node("ball"), "position", vmath.vector3(280, 200, 0))
				end
				gui.set_visible(gui.get_node("ball"), true)
				gui.animate(gui.get_node("cup1"), "position", vmath.vector3(280, 300, 0), gui.EASING_LINEAR, 3, 0, nil, gui.PLAYBACK_ONCE_PINGPONG)
				gui.animate(gui.get_node("cup2"), "position", vmath.vector3(480, 300, 0), gui.EASING_LINEAR, 3, 0, nil, gui.PLAYBACK_ONCE_PINGPONG)
				gui.animate(gui.get_node("cup3"), "position", vmath.vector3(680, 300, 0), gui.EASING_LINEAR, 3, 0, nil, gui.PLAYBACK_ONCE_PINGPONG)
				timer.delay(3, false, function()
					msg.post(".", "release_input_focus")
					msg.post("main:/minigame collection#main", "trick", {"doors"})
				end)
			else
				gui.set(gui.get_node(v), "scale", vmath.vector3(2.2, 2.2, 1))
			end
		else
			gui.set(gui.get_node(v), "scale", vmath.vector3(2, 2, 1))
		end
	end
end

