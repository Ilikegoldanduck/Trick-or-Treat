local yourHand = {
	1, 1
}

local enemyHand = {
	1, 1
}

--index 1 = left index 2 = right

function init(self)
	msg.post(".", "acquire_input_focus")
	local index = 1
	timer.delay(.2, true, function()
		for i, v in ipairs({"leftHand", "rightHand", "leftHandE", "rightHandE"}) do
			gui.play_flipbook(gui.get_node(v), "finger" .. tostring(index))
		end
		gui.play_flipbook(gui.get_node("knife"), "knife" .. tostring(index))
		index = index + 1
	end)
	timer.delay(1, true, function()
		if chosenHand == nil then
			gui.animate(gui.get_node("leftHand"), "position", vmath.vector3(), gui.EASING_LINEAR, 1, 0)
			gui.animate(gui.get_node("rightHand"), "position", vmath.vector3(), gui.EASING_LINEAR, 1, 0)
		elseif chosenHand == 1 then
			gui.animate(gui.get_node("leftHand"), "position", vmath.vector3(), gui.EASING_LINEAR, 1, 0)
			gui.animate(gui.get_node("rightHand"), "position", vmath.vector3(), gui.EASING_LINEAR, 1, 0)
		else
			gui.animate(gui.get_node("leftHand"), "position", vmath.vector3(), gui.EASING_LINEAR, 1, 0)
			gui.animate(gui.get_node("rightHand"), "position", vmath.vector3(), gui.EASING_LINEAR, 1, 0)
		end
	end)
end

function on_message(self, message_id, message, sender)
	-- Add message-handling code here
	-- Learn more: https://defold.com/manuals/message-passing/
	-- Remove this function if not needed
end

function enemyTurn()
	--umm should I use AI or should I just rig it again..?
	gui.animate(gui.get_node("knife"), "position", vmath.vector3(480, 640, 0), gui.EASING_LINEAR, 1, 0)
end

local chosenHand = nil
local yourTurn = true

function on_input(self, action_id, action)
	if yourTurn then
		if chosenHand then
			for i, v in ipairs({"leftHandE", "rightHandE"}) do
				if gui.pick_node(gui.get_node(v), action.x, action.y) and action_id == hash("touch") and action.pressed then
					yourTurn = false
					gui.animate(".")
					if enemyHand[i] >= 5 then
						enemyHand[i] = 0
					end
					updateHands()
					timer.delay(1, false, function()
						enemyTurn()
					end)
				end
			end
		end
		for i, v in ipairs({"leftHand", "rightHand"}) do
			if gui.pick_node(gui.get_node(v), action.x, action.y) and action_id == hash("touch") and action.pressed then
				chosenHand = i
			end
		end
	end
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
