local yourHand = {
	1, 1
}

local enemyHand = {
	1, 1
}

--index 1 = left index 2 = right
local chosenHand = nil

function init(self)
	msg.post(".", "acquire_input_focus")
	local index = 1
	timer.delay(.2, true, function()
		for i, v in ipairs({"leftHand", "rightHand", "leftHandE", "rightHandE"}) do
			gui.play_flipbook(gui.get_node(v), "finger" .. tostring(index))
		end
		gui.play_flipbook(gui.get_node("knife"), "knife" .. tostring(index))
		index = index + 1
		if index > 3 then
			index = 1
		end
	end)
	timer.delay(1, true, function()
		if chosenHand == nil then
			gui.animate(gui.get_node("leftHand"), "position", vmath.vector3(300, 30, 0), gui.EASING_LINEAR, 1, 0)
			gui.animate(gui.get_node("rightHand"), "position", vmath.vector3(660, 30, 0), gui.EASING_LINEAR, 1, 0)
		elseif chosenHand == 1 then
			gui.animate(gui.get_node("leftHand"), "position", vmath.vector3(300, 70, 0), gui.EASING_LINEAR, 1, 0)
			gui.animate(gui.get_node("rightHand"), "position", vmath.vector3(660, 30, 0), gui.EASING_LINEAR, 1, 0)
		else
			gui.animate(gui.get_node("leftHand"), "position", vmath.vector3(300, 30, 0), gui.EASING_LINEAR, 1, 0)
			gui.animate(gui.get_node("rightHand"), "position", vmath.vector3(660, 70, 0), gui.EASING_LINEAR, 1, 0)
		end
	end)
end

function enemyTurn()
	--umm should I use AI or should I just rig it again..?
	gui.animate(gui.get_node("knife"), "position", vmath.vector3(480, 540, 0), gui.EASING_LINEAR, 1, 0)
	timer.delay(2, false, function()
		msg.post("main:/minigame collection#main", "trick", {"doors"})
	end)
end

local yourTurn = true

function on_input(self, action_id, action)
	if chosenHand then
		for i, v in ipairs({"leftHandE", "rightHandE"}) do
			if gui.pick_node(gui.get_node(v), action.x, action.y) and action_id == hash("touch") and action.pressed then
				msg.post(".", "release_input_focus")
				gui.animate(gui.get_node(v), "position.y", 750, gui.EASING_LINEAR, 1, 0)
				timer.delay(2, false, function()
					enemyTurn()
				end)
			end
		end
	end
	for i, v in ipairs({"leftHand", "rightHand"}) do
		if gui.pick_node(gui.get_node(v), action.x, action.y) and action_id == hash("touch") and action.pressed then
			chosenHand = i
			pprint(chosenHand)
		end
	end
end