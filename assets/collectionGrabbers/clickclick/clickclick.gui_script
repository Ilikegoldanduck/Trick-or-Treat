local clickerTable = {}

function init(self)
	msg.post(".", "acquire_input_focus")
	for i = 0, 4, 1 do
		local clicker = gui.clone(gui.get_node("clicker"))
		pprint(clicker)
		table.insert(clickerTable, clicker)
	end
	gui.set(clickerTable[1], "position", vmath.vector3(200, 100, 0))
	gui.set(clickerTable[2], "position", vmath.vector3(200, 540, 0))
	gui.set(clickerTable[3], "position", vmath.vector3(480, 320, 0))
	gui.set(clickerTable[4], "position", vmath.vector3(760, 100, 0))
	gui.set(clickerTable[5], "position", vmath.vector3(760, 540, 0))
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_input(self, action_id, action)
	for i, v in ipairs(clickerTable) do
		if gui.pick_node(v, action.x, action.y) and action_id == hash("touch") and action.pressed then
			gui.set_enabled(v, false)
			table.remove(clickerTable, i)
			if #clickerTable == 0 then
				msg.post(".", "release_input_focus")
				msg.post("main:/minigame collection#main", "trick", {"doors"})
			end
		end
	end
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
