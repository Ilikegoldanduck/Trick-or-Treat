function flip(side)
	gui.animate(gui.get_node("heads"), "color.w", 0, gui.EASING_LINEAR, 1, 0)
	gui.animate(gui.get_node("tails"), "color.w", 0, gui.EASING_LINEAR, 1, 0)
	gui.animate(gui.get_node("text"), "color.w", 0, gui.EASING_LINEAR, 1, 0)
	local heads = (side == "heads")
	local index = 1

	timer.delay(.5, true, function(self, handle)
		gui.animate(gui.get_node("coin"), "color.w", 0, gui.EASING_LINEAR, .2, 0)
		timer.delay(.2, false, function()
			if heads then
				gui.play_flipbook(gui.get_node("coin"), "heads")
			else
				gui.play_flipbook(gui.get_node("coin"), "tails")
			end
			timer.delay(.05, false, function()
				gui.animate(gui.get_node("coin"), "color.w", 1, gui.EASING_LINEAR, .2, 0)
			end)
		end)
		heads = not heads
		index = index + 1
		if index == 11 then
			timer.cancel(handle)
			timer.delay(1, false, function()
				gui.animate(gui.get_node("coin"), "color.w", 0, gui.EASING_LINEAR, .2, 0)
			end)
			timer.delay(.7, false, function()
				msg.post("main:/minigame collection#main", "trick", {"doors"})
			end)
		end
	end)
end

local coinTable = {
	"heads",
	"tails"
}

function on_input(self, action_id, action)
	for i, v in ipairs(coinTable) do
		if gui.pick_node(gui.get_node(v), action.x, action.y) then
			if action_id == hash("touch") and action.pressed then
				msg.post(".", "release_input_focus")
				flip(v)
			else
				gui.set(gui.get_node(v), "scale", vmath.vector3(.6, .6, 1))
			end
		else
			gui.set(gui.get_node(v), "scale", vmath.vector3(.5, .5, 1))
		end
	end
end

