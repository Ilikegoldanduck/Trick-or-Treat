function flip(side)
	
end

local coinTable = {
	"heads",
	"tails"
}

function on_input(self, action_id, action)
	for i, v in ipairs(coinTable) do
		if gui.pick_node(gui.get_node(v), action.x, action.y) then
			if action_id == hash("touch") and action.pressed then
				flip(v)
			else
				gui.set(gui.get_node(v), "scale", vmath.vector3(1.2, 1.2, 1))
			end
		else
			gui.set(gui.get_node(v), "scale", vmath.vector3(1, 1, 1))
		end
	end
end

