local countingTable = {
	{"c", false},
	{"d", false},
	{"tile", false},
	{"a", false},
	{"y", false}
}

local swap = false

function init(self)
	msg.post(".", "acquire_input_focus")
	local index = 1
	timer.delay(.2, true, function()
		for i, v in ipairs(countingTable) do
			if swap then
				if i == 2 then
					gui.play_flipbook(gui.get_node(v[1]), "a" .. index)
				elseif i == 4 then
					gui.play_flipbook(gui.get_node(v[1]), "d" .. index)
				end
			else
				gui.play_flipbook(gui.get_node(v[1]), v[1] .. index)
			end
		end
		index = index + 1
		if index > 3 then 
			index = 1
		end
	end)
end

function on_input(self, action_id, action)
	swap = false
	for i, v in ipairs(countingTable) do
		if (i == 2 or i == 4) and gui.pick_node(gui.get_node(v[1]), action.x, action.y) then
			swap = true
		end
		if gui.pick_node(gui.get_node(v[1]), action.x, action.y) and action_id == hash("touch") and action.pressed then
			if i == 1 then
				countingTable[i][2] = true
				gui.set_enabled(gui.get_node(v[1]), false)
			elseif countingTable[i - 1][2] == true then
				countingTable[i][2] = true
				gui.set_enabled(gui.get_node(v[1]), false)
			else
				for i, v in ipairs(countingTable) do
					countingTable[i][2] = false
					gui.set_enabled(gui.get_node(v[1]), true)
				end
			end
		end
	end
end