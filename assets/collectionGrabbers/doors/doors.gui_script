local doors = require("assets.scripts.doors")

local onDoor = false
local inChat = false

function init(self)
	msg.post(".", "acquire_input_focus")
end

function check()
	gui.set_text(gui.get_node("candy"), tostring(doors.getCandy()))
	gui.set_text(gui.get_node("doorThing"), tostring(doors.getDoor()))
	if doors.getDoor() == 1 then
		gui.set_enabled(gui.get_node("leftarrow"), false)
	else
		gui.set_enabled(gui.get_node("leftarrow"), true)
	end
	if doors.getDoorAvail() then
		gui.set_enabled(gui.get_node("forwardarrow"), false)
		gui.set_enabled(gui.get_node("rightarrow"), true)
	else
		gui.set_enabled(gui.get_node("forwardarrow"), true)
		gui.set_enabled(gui.get_node("rightarrow"), false)
	end
end

function update(self, dt)
	check()
end

local function visual()
	if onDoor then
		gui.set_visible(gui.get_node("backwardarrow"), true)
		gui.set_visible(gui.get_node("leftarrow"), false)
		gui.set_visible(gui.get_node("rightarrow"), false)
	else
		gui.set_visible(gui.get_node("backwardarrow"), false)
		gui.set_visible(gui.get_node("leftarrow"), true)
		gui.set_visible(gui.get_node("rightarrow"), true)
	end
end

local arrowTable = {
	"leftarrow",
	"rightarrow",
	"forwardarrow"
}

local treat

local function startChat()
	inChat = true
	msg.post("go#doors", "open")
	treat = doors.increaseCandy()
	gui.set_text(gui.get_node("talkText"), doors.getDoorInfo())
	gui.set_enabled(gui.get_node("chat"), true)
end

function on_input(self, action_id, action)
	if inChat then
		if action_id == hash("touch") and action.pressed then
			if type(treat) == "number" then

			else
				msg.post("go#doors", "trick", {treat})
			end
			inChat = false
			gui.set_enabled(gui.get_node("chat"), false)
			msg.post("go#doors", "close")
		end
	elseif onDoor then
		if gui.pick_node(gui.get_node("forwardarrow"), action.x, action.y) and not doors.getDoorAvail() then
			if action_id == hash("touch") and action.pressed then
				startChat()
			else
				gui.set(gui.get_node("forwardarrow"), "scale", vmath.vector3(2.2, 2.2, 1))

			end
		else
			gui.set(gui.get_node("forwardarrow"), "scale", vmath.vector3(2, 2, 1))
		end
		if gui.pick_node(gui.get_node("backwardarrow"), action.x, action.y) then
			if action_id == hash("touch") and action.pressed then
				onDoor = false
				visual()
			else
				gui.set(gui.get_node("backwardarrow"), "scale", vmath.vector3(2.2, 2.2, 1))
			end
		else
			gui.set(gui.get_node("backwardarrow"), "scale", vmath.vector3(2, 2, 1))
		end
	else
		for i, v in ipairs(arrowTable) do
			if gui.pick_node(gui.get_node(v), action.x, action.y) then			
				if action_id == hash("touch") and action.pressed then
					if v == "leftarrow" then
						doors.prevDoor()
					elseif v == "rightarrow" and doors.getDoorAvail() then
						doors.nextDoor()
					elseif v == "forwardarrow" and not doors.getDoorAvail() then
						onDoor = true
						visual()
					end
					check()
				else
					gui.set(gui.get_node(v), "scale", vmath.vector3(2.2, 2.2, 1))
				end
			else
				gui.set(gui.get_node(v), "scale", vmath.vector3(2, 2, 1))
			end
		end
	end
end