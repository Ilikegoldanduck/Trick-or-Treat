function init(self)
	local index = 1
	timer.delay(.2, true, function()
		index = index + 1
		if index > 3 then
			index = 1
		end
		gui.play_flipbook(gui.get_node("hug"), "hug" .. tostring(index))
	end)
	timer.delay(10, false, function()
		msg.post("main:/minigame collection#main", "trick", {"doors"})
	end)
end