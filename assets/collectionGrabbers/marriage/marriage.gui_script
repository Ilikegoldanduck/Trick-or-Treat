local guiTable = {
	"hold",
	"tile"
}

function init(self)
	local index = 1
	timer.delay(.2, true, function()
		for i, v in ipairs(guiTable) do
			gui.play_flipbook(gui.get_node(v), v .. index)
		end
		index = index + 1
		if index > 3 then
			index = 1
		end
	end)
	timer.delay(1, false, function()
		msg.post(".", "acquire_input_focus")
		gui.set_enabled(gui.get_node("tile"), true)
	end)
end

function on_input(self, action_id, action)
	if gui.pick_node(gui.get_node("tile"), action.x, action.y) and action_id == hash("tough") and action.pressed then
		msg.post("main:/soundHandler#soundHandler", "sound", {"cup"})
		gui.set_enabled(gui.get_node("tile"), false)
		msg.post(".", "acquire_input_focus")
		msg.post("main:/minigame collection#main", "trick", {"doors"})
	end
end