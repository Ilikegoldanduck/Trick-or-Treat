local health = 10

local index = 1
local temp = false

function init(self)
	msg.post(".", "acquire_input_focus")
	gui.animate(gui.get_node("hit"), "position.y", 120, gui.EASING_LINEAR, 2, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
	gui.animate(gui.get_node("hit"), "position.x", 760, gui.EASING_LINEAR, 4, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
	timer.delay(.5, true, function()		
		if temp then
			temp = false
			gui.play_flipbook(gui.get_node("box"), "ghostHurt")
		else
			index = index + 1
			if index > 3 then
				index = 1
			end
			gui.play_flipbook(gui.get_node("box"), "ghost" .. tostring(index))
		end
	end)
end

function on_input(self, action_id, action)
	if gui.pick_node(gui.get_node("hit"), action.x, action.y) and action_id == hash("touch") and action.pressed then
		health = health - 1
		temp = true
		msg.post("main:/soundHandler#soundHandler", "sound", {"hit"})
		gui.animate(gui.get_node("healthBar"), "size.x", health * 30, gui.EASING_LINEAR, 0.1)
		if health <= 0 then
			msg.post(".", "release_input_focus")
			msg.post("main:/minigame collection#main", "trick", {"doors"})
		end
	end
end