local health = 10

function init(self)
	msg.post(".", "acquire_input_focus")
	gui.animate(gui.get_node("hit"), "position.y", 320, gui.EASING_LINEAR, 2, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
	gui.animate(gui.get_node("hit"), "position.x", 760, gui.EASING_LINEAR, 4, 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
end

function on_input(self, action_id, action)
	if gui.pick_node(gui.get_node("hit"), action.x, action.y) and action_id == hash("touch") and action.pressed then
		health = health - 1
		gui.animate(gui.get_node("healthBar"), "size.x", health * 30, gui.EASING_LINEAR, 0.1)
		if health <= 0 then
			msg.post(".", "release_input_focus")
			msg.post("main:/minigame collection#main", "trick", {"doors"})
		end
	end
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
