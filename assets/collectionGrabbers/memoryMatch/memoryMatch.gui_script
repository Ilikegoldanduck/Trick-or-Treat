local tiles = {
	"tile1",
	"tile2",
	"tile3",
	"tile4",
	"tile5",
	"tile6",
	"tile7",
	"tile8",
	"tile9"
}

function init(self)
	for i, v in ipairs(tiles) do
		gui.animate(gui.get_node(v), "position", vmath.vector3(480, 320, 0), gui.EASING_LINEAR, 1.5, 0, function()
			gui.animate(gui.get_node(v), "position", vmath.vector3(((i - 1) % 3 + 1) * 200 + 80, (math.floor((i - 1) / 3) + 1) * 150 + 20, 0), gui.EASING_LINEAR, 1.5, 0, function()
				msg.post(".", "acquire_input_focus")
			end)
		end)
	end
end

function spin()
	
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	
end

function on_input(self, action_id, action)
	for i, v in ipairs(tiles) do
		if gui.pick_node(gui.get_node(v), action.x, action.y) and action_id == hash("touch") and action.pressed then
			gui.set_enabled(gui.get_node(v), false)
			table.remove(tiles, i)
			if #tiles == 0 then
				msg.post(".", "release_input_focus")
				msg.post("main:/minigame collection#main", "trick", {"doors"})
			end
		end
	end
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
