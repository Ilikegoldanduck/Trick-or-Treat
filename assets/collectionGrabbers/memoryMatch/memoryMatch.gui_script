local tiles = {
	"tile1",
	"tile2",
	"tile3",
	"tile4",
	"tile5",
	"tile6",
	"tile7",
	"tile8",
	"tile9"
}

local temp = 1
local temptemp = true

function init(self)
	for i, v in ipairs(tiles) do
		timer.delay(1, false, function()
			gui.animate(gui.get_node(v), "color.w", 0, gui.EASING_LINEAR, 2, 0, nil, gui.PLAYBACK_ONCE_PINGPONG)
			timer.delay(1, false, function()
				gui.play_flipbook(gui.get_node(v), "untitled")
			end)
			timer.delay(2, false, function()
				gui.animate(gui.get_node(v), "position", vmath.vector3(480, 320, 0), gui.EASING_LINEAR, 1.5, 0, function()
					gui.animate(gui.get_node("text"), "color.w", 1, gui.EASING_LINEAR, 1.5, 0)
					gui.animate(gui.get_node(v), "position", vmath.vector3(((i - 1) % 3 + 1) * 200 + 80, (math.floor((i - 1) / 3) + 1) * 150 + 20, 0), gui.EASING_LINEAR, 1.5, 0, function()
						msg.post(".", "acquire_input_focus")
					end)
				end)
			end)
		end)
	end
end

function on_input(self, action_id, action)
	if temptemp then
		for i, v in ipairs(tiles) do
			if gui.pick_node(gui.get_node(v), action.x, action.y) then
				if action_id == hash("touch") and action.pressed then
					temptemp = false
					msg.post("main:/soundHandler#soundHandler", "sound", {"card"})
					if temp ~= 3 then
						temp = temp + 1
						gui.set_text(gui.get_node("text"), "Pick " .. (4 - temp))
						gui.animate(gui.get_node(v), "color.w", 0, gui.EASING_LINEAR, 2, 0, nil, gui.PLAYBACK_ONCE_PINGPONG)
						timer.delay(1, false, function()
							temptemp = true
							gui.play_flipbook(gui.get_node(v), "candy")
						end)
					else
						msg.post(".", "release_input_focus")
						gui.animate(gui.get_node("text"), "color.w", 0, gui.EASING_LINEAR, 1, 0)
						gui.animate(gui.get_node(v), "color.w", 0, gui.EASING_LINEAR, 2, 0, nil, gui.PLAYBACK_ONCE_PINGPONG)
						timer.delay(1, false, function()
							gui.play_flipbook(gui.get_node(v), "mines")
							timer.delay(1, false, function()
								msg.post("main:/minigame collection#main", "trick", {"doors"})
							end)
						end)
					end
					table.remove(tiles, i)
				else
					gui.set(gui.get_node(v), "scale", vmath.vector3(.8, .8, 1))
				end
			else
				gui.set(gui.get_node(v), "scale", vmath.vector3(.7, .7, 1))
			end
		end
	end
end