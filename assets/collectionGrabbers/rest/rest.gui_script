	-- Add message-handling code here
	-- Learn more: https://defold.com/manuals/message-passing/
	-- Remove this function if not needed
end

function on_input(self, action_id, action)
	if gui.pick_node("candy", action.x, action.y) then
		if action_id == hash("touch") and action.pressed then
			msg.post("main:/soundHandler#soundHandler", "soundStop", {"fire"})
			msg.post("main:/soundHandler#soundHandler", "sound", {"candy"})
			msg.post("main:/minigame collection#main", "trick", {"doors"})
		else
			gui.set(gui.get_node("candy"), "scale", vmath.vector3(1.2, 1.2, 1))
		end
	else
		gui.set(gui.get_node("candy"), "scale", vmath.vector3(1, 1, 1))
	end
end

