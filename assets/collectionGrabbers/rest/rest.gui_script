local restTable = {
	"cat",
	"candy",
	"man",
	"fire"
}

function init(self)
	msg.post(".", "acquire_input_focus")
	local index = 1
	timer.delay(1, true, function()
		for i, v in ipairs(restTable) do
			gui.play_flipbook(gui.get_node(v), v .. tostring(index))
		end
		index = index + 1
		if index > 3 then
			index = 1
		end
	end)
	msg.post("main:/soundHandler#soundHandler", "sound", {"fire"})
	timer.delay(554, true, function()
		msg.post("main:/soundHandler#soundHandler", "sound", {"fire"})
	end)
end

