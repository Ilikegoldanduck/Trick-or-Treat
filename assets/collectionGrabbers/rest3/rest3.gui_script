local restTable = {
	"cat",
	"candy",
	"candy1",
	"man",
	"fire"
}

local stop = false

function init(self)
	msg.post(".", "acquire_input_focus")
	local index = 1
	timer.delay(.2, true, function()
		for i, v in ipairs(restTable) do
			if v == "candy1" then
				gui.play_flipbook(gui.get_node(v), "candy" .. tostring(index))
			else
				gui.play_flipbook(gui.get_node(v), v .. tostring(index))
			end
		end
		index = index + 1
		if index > 3 then
			index = 1
		end
	end)
	msg.post("main:/soundHandler#soundHandler", "sound", {"fire"})
	timer.delay(554, true, function()
		if not stop then
			msg.post("main:/soundHandler#soundHandler", "sound", {"fire"})
		end
	end)
end

local manText = {
	"Hi again!",
	"What have you gone through?",
	"Take these candies :p",
	"The fire's very comfy :3",
	"You should take a nap!",
	"Remember to drink water!"
}

local textAfter = {
	"Sigh... Are they gone yet?",
	"maow",
	"Yeah... I know... \nI can't believe this",
	"meow",
	"monsters am I right..."
}

local catText = {
	"maow",
	"meow",
	"mrowr",
	"miaow",
	"rawr",
	"uwu"
}

local candyTouched = 0
local c1 = false
local c2 = false

function on_input(self, action_id, action)
	if gui.pick_node(gui.get_node("candy"), action.x, action.y) and not c1 then
		if action_id == hash("touch") and action.pressed then
			gui.set_enabled(gui.get_node("candy"), false)
			candyTouched = candyTouched + 1
			c1 = true
			msg.post("main:/soundHandler#soundHandler", "sound", {"candy"})
		else
			gui.set(gui.get_node("candy"), "scale", vmath.vector3(1.2, 1.2, 1))
		end
	else
		gui.set(gui.get_node("candy"), "scale", vmath.vector3(1, 1, 1))
	end
	if gui.pick_node(gui.get_node("candy1"), action.x, action.y) and not c2 then
		if action_id == hash("touch") and action.pressed then
			gui.set_enabled(gui.get_node("candy1"), false)
			candyTouched = candyTouched + 1
			c2 = true
			msg.post("main:/soundHandler#soundHandler", "sound", {"candy"})
		else
			gui.set(gui.get_node("candy1"), "scale", vmath.vector3(1.2, 1.2, 1))
		end
	else
		gui.set(gui.get_node("candy1"), "scale", vmath.vector3(1, 1, 1))
	end
	if candyTouched == 2 then
		msg.post(".", "release_input_focus")
		msg.post("main:/soundHandler#soundHandler", "soundStop", {"fire"})
		stop = true
		timer.delay(1, false, function()
			gui.set_text(gui.get_node("manText"), textAfter[1])
		end)
		timer.delay(2, false, function()
			gui.set_text(gui.get_node("catText"), textAfter[2])
		end)
		timer.delay(3, false, function()
			gui.set_text(gui.get_node("manText"), textAfter[3])
		end)
		timer.delay(4, false, function()
			gui.set_text(gui.get_node("catText"), textAfter[4])
		end)
		timer.delay(5, false, function()
			gui.set_text(gui.get_node("manText"), textAfter[5])
		end)
		timer.delay(6, false, function()
			msg.post("main:/minigame collection#main", "trick", {"doors"})
		end)
	end
	if gui.pick_node(gui.get_node("man"), action.x, action.y) and action_id == hash("touch") and action.pressed then
		gui.set_text(gui.get_node("manText"), manText[math.random(1, 6)])
	elseif gui.pick_node(gui.get_node("cat"), action.x, action.y) and action_id == hash("touch") and action.pressed then
		gui.set_text(gui.get_node("catText"), catText[math.random(1, 6)])
	end
end