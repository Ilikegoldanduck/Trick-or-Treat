local restTable = {
	"man",
	"tile",
	"tile1",
	"scary",
	"candy",
	"q"
}

function init(self)
	msg.post(".", "acquire_input_focus")
	local index = 1
	timer.delay(.2, true, function()
		for i, v in ipairs(restTable) do
			if v == "tile1" then
				gui.play_flipbook(gui.get_node(v), "candy" .. tostring(index))
			else
				gui.play_flipbook(gui.get_node(v), v .. tostring(index))
			end
		end
		index = index + 1
		if index > 3 then
			index = 1
		end
	end)
end

local chatIndex = 0
local chatcd = false
local manText = {
	"Hi!",
	"Say... You've been through a lot right?",
	"Collecting candies...",
	"Experiencing horrors.....",
	"Seeing things that are downright weird and insane!",
	"What do you think this all means?",
	"Why are you collecting candies?",
	"Why are we experiencing these... phenomenons?",
	"Do you even have... free will?",
	"Did you... even enjoy this..?"
}

function nextChat()
	chatcd = true
	timer.delay(.5, false, function()
		chatcd = false
	end)
	chatIndex = chatIndex + 1
	if (chatIndex == 3 or chatIndex == 7) then
		gui.set_visible(gui.get_node("candy"), true)
	else
		gui.set_visible(gui.get_node("candy"), false)
	end
	if (chatIndex == 4 or chatIndex == 8) then
		gui.set_visible(gui.get_node("scary"), true)
	else
		gui.set_visible(gui.get_node("scary"), false)
	end
	if (chatIndex == 5 or chatIndex == 6 or chatIndex == 9) then
		gui.set_visible(gui.get_node("q"), true)
	else
		gui.set_visible(gui.get_node("q"), false)
	end
	gui.set_visible(gui.get_node("manText"), true)
	gui.set_text(gui.get_node("manText"), )
end

function on_input(self, action_id, action)

end