function init(self)
	msg.post(".", "acquire_input_focus")
end

local inputs = {
	"rock",
	"paper",
	"scissors"
}

function playGame()
	for i, v in ipairs(inputs) do
		gui.animate(gui.get_node(v), "color.w", 0, gui.EASING_LINEAR, 1, 0)
	end
	gui.animate(gui.get_node("text"), "color.w", 0, gui.EASING_LINEAR, 1, 0)
	timer.delay(2, false, function()
		gui.animate(gui.get_node("gun"), "color.w", 1, gui.EASING_LINEAR, 2, 0, function()
		msg.post("main:/soundHandler#soundHandler", "sound", {"gun"})
			timer.delay(.5, false, function()
				msg.post(".", "release_input_focus")
				msg.post("main:/minigame collection#main", "trick", {"doors"})
			end)
		end)
	end)
end

function on_input(self, action_id, action)
	for i, v in ipairs(inputs) do
		if gui.pick_node(gui.get_node(v), action.x, action.y) then
			if action_id == hash("touch") and action.pressed then
				playGame()
			else
				gui.set(gui.get_node(v), "scale", vmath.vector3(1.2, 1.2, 1.2))
			end
		else
			gui.set(gui.get_node(v), "scale", vmath.vector3(1, 1, 1))	
		end
	end
end