local tileTable2 = {"c", "a", "n", "d", "y"}

function init(self)
	msg.post(".", "acquire_input_focus")
	local index = 1
	timer.delay(.2, true, function()
		for i, v in ipairs(tileTable2) do
			if v == "n" then

			else
				gui.play_flipbook(gui.get_node(v), v .. tostring(index))
			end
			gui.play_flipbook(gui.get_node(v .. "1"), "tile" .. tostring(index))
		end
		index = index + 1
		if index > 3 then
			index = 1
		end
	end)
end

