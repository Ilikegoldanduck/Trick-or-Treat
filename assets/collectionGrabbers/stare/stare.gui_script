local aidTable = {
	"aid1",
	"aid2"
}

local eyeTable = {
	"eye1",
	"eye2"
}

local selected = nil
local selectedIndex = nil

function on_input(self, action_id, action)
	if (selected == nil) and action_id == hash("touch") and action.pressed then
		for i, v in ipairs(aidTable) do
			if gui.pick_node(gui.get_id(v), action.x, action.y) then
				selected = v
				selectedIndex = i
			end
		end
	elseif selected then
		gui.set(gui.get_id(selected), "position", vmath.vector3(action.x, action.y, 0))
		for i, v in ipairs(eyeTable) do
			if gui.pick_node(gui.get_id(v), action.x, action.y) then
				gui.set(gui.get_id(selected), "position", gui.get(gui.get_id(v, "position")))
				selected = nil
				table.remove(aidTable, selectedIndex)
				selectedIndex = 0
				if #aidTable == 0 then
					msg.post("go#doors", "trick", {"doors"})
				end
			end
		end
	end
end

