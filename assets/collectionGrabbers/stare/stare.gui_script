local stareTable = {
	{"eye1", "eye"},
	{"eye2", "eye"},
	{"aid1", "aid"},
	{"aid2", "aid"}
}

function init(self)
	msg.post(".", "acquire_input_focus")
	local index = 1	
	timer.delay(1, true, function()
		index = index + 1
		if index > 3 then
			index = 1
		end
		for i, v in ipairs(stareTable) do
			gui.play_flipbook(gui.get_id(v[1]), v[2] .. tostring(index))
		end
	end)
end


