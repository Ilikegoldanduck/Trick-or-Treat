local stareTable = {
	{"eye1", "eye"},
	{"eye2", "eye"},
	{"aid1", "aid"},
	{"aid2", "aid"},
	{"eye", "eye"},
	{"eye3", "eye"},
	{"eye4", "eye"},
	{"eye5", "eye"},
	{"aid", "aid"},
	{"aid4", "aid"},
	{"aid5", "aid"},
	{"aid3", "aid"}
}

function init(self)
	msg.post(".", "acquire_input_focus")
	local index = 1	
	timer.delay(1, true, function()
		index = index + 1
		if index > 3 then
			index = 1
		end
		for i, v in ipairs(stareTable) do
			gui.play_flipbook(gui.get_node(v[1]), v[2] .. tostring(index))
		end
	end)
end

local aidTable = {
	"aid",
	"aid1",
	"aid3",
	"aid4",
	"aid5",
	"aid2"
}

local eyeTable = {
	"eye",
	"eye1",
	"eye3",
	"eye4",
	"eye5",
	"eye2"
}

local selected = nil
local selectedIndex = nil

function on_input(self, action_id, action)
	if (selected == nil) and action_id == hash("touch") and action.pressed then
		for i, v in ipairs(aidTable) do
			if gui.pick_node(gui.get_node(v), action.x, action.y) then
				selected = v
				selectedIndex = i
			end
		end
	elseif selected then
		gui.set(gui.get_node(selected), "position", vmath.vector3(action.x, action.y, 0))
		for i, v in ipairs(eyeTable) do
			if gui.pick_node(gui.get_node(v), action.x, action.y) then
				gui.set(gui.get_node(selected), "position", gui.get(gui.get_node(v), "position"))
				selected = nil
				table.remove(aidTable, selectedIndex)
				table.remove(eyeTable, i)
				selectedIndex = 0
				msg.post("main:/soundHandler#soundHandler", "sound", {"bandaid"})
				if #aidTable == 0 then
					msg.post(".", "release_input_focus")
					for i, v in ipairs(stareTable) do
						gui.animate(gui.get_node(v[1]), "color.w", 0, gui.EASING_LINEAR, .5, 0)
					end
					msg.post("main:/minigame collection#main", "trick", {"doors"})
				end
			end
		end
	end
end