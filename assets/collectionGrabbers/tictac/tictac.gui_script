local tileTable = {
	"tile1",
	"tile2",
	"tile3",
	"tile4",
	"tile6",
	"tile7",
	"tile8",
	"tile9"
}

local selected = false

function on_input(self, action_id, action)
	if circle ~= nil and gui.pick_node(circle, action.x, action.y) and action_id == hash("touch") and action.pressed and not selected then
		selected = true
	elseif selected and action_id == hash("touch") and action.pressed then
		for i, v in ipairs(tileTable) do
			if gui.pick_node(gui.get_node(v), action.x, action.y) then
				selected = false
				local t = gui.get_position(gui.get_node(v))
				pprint(gui.get_position(gui.get_node(v)))
				gui.set_position(circle, vmath.vector3(t.x + 480, t.y + 320, 0))
				table.remove(tileTable, i)
				circle = nil
			end
		end
	end
	if selected and circle ~= nil then
		gui.set_position(circle, vmath.vector3(action.x, action.y, 0))
	end
end

