local tileTable = {
	"tile1",
	"tile2",
	"tile3",
	"tile4",
	0, 
	"tile6",
	"tile7",
	"tile8",
	"tile9"
}

local direction = 1

local turn1 = nil

function enemyTurn1()
	local temp = gui.clone(gui.get_node("cross"))
	table.insert(guiTable, temp)
	if tileTable[4] == nil then
		tileTable[6] = 0
		gui.set_position(temp, vmath.vector3(580, 320, 0))
		turn1 = 6
	else
		tileTable[4] = 0
		gui.set_position(temp, vmath.vector3(380, 320, 0))
		turn1 = 4
	end
	msg.post("main:/soundHandler#soundHandler", "sound", {"bandaid"})
	timer.delay(1, false, function()
		circle = gui.clone(gui.get_node("circle"))
		gui.set_position(circle, vmath.vector3(50, 50, 0))
		table.insert(guiTable, circle)
	end)
end

function enemyTurn2()
	local temp = gui.clone(gui.get_node("cross"))
	msg.post("main:/soundHandler#soundHandler", "sound", {"bandaid"})
	table.insert(guiTable, temp)
	if turn1 == 4 then
		gui.set_position(temp, vmath.vector3(280, 320, 0))
	else
		gui.set_position(temp, vmath.vector3(680, 320, 0))
	end
	msg.post(".", "release_input_focus")
	timer.delay(1, false, function()
		msg.post("main:/minigame collection#main", "trick", {"doors"})
	end)
end

local selected = false

function on_input(self, action_id, action)
	if circle ~= nil and gui.pick_node(circle, action.x, action.y) and action_id == hash("touch") and action.pressed and not selected then
		selected = true
	elseif circle ~= nil and selected and action_id == hash("touch") and action.pressed then
		for i, v in ipairs(tileTable) do
			pprint(v)
			if v ~= 0 then
				pprint(gui.pick_node(gui.get_node(v), action.x, action.y))
			end
			if v ~= 0 and gui.pick_node(gui.get_node(v), action.x, action.y) then
				msg.post("main:/soundHandler#soundHandler", "sound", {"bandaid"})
				selected = false
				local t = gui.get_position(gui.get_node(v))
				pprint(gui.get_position(gui.get_node(v)))
				gui.set_position(circle, vmath.vector3(t.x + 480, t.y + 320, 0))
				tileTable[i] = 0
				circle = nil
				timer.delay(1, false, function()
					if turn1 == nil then
						enemyTurn1()
					else
						enemyTurn2()
					end
				end)
			end
		end
	end
	if selected and circle ~= nil then
		gui.set_position(circle, vmath.vector3(action.x, action.y, 0))
	end
end

