local guiTable = {}

local circle = nil

function init(self)
	timer.delay(1, false, function()
		msg.post("main:/soundHandler#soundHandler", "sound", {"bandaid"})
		local temp = gui.clone(gui.get_node("cross"))	
		gui.set_position(temp, vmath.vector3(480, 320, 0))
		table.insert(guiTable, temp)
		msg.post(".", "acquire_input_focus")
		circle = gui.clone(gui.get_node("circle"))
		gui.set_position(circle, vmath.vector3(50, 50, 0))
		table.insert(guiTable, circle)
	end)
	local index = 1
	--[[ Temporary for after assets are made
	timer.delay(.2, true, function()
		for i, v in ipairs(guiTable) do
			gui.play_flipbook(v, v .. tostring(index))
		end
		index = index + 1
		if index > 3 then
			index = 1
		end
	)
	]]
end

