local doors = require("assets.scripts.doors")

local onDoor = false

function init(self)
	msg.post(".", "acquire_input_focus")
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	gui.set_text(gui.get_node("candy"), tostring(doors.getCandy()))
end

function on_message(self, message_id, message, sender)
	-- Add message-handling code here
	-- Learn more: https://defold.com/manuals/message-passing/
	-- Remove this function if not needed
end

local function visual()
	if onDoor then
		gui.set_enabled(gui.get_node("backwardarrow"), true)
		gui.set_enabled(gui.get_node("leftarrow"), false)
		gui.set_enabled(gui.get_node("rightarrow"), false)
		gui.set_enabled(gui.get_node("forwardarrow"), true)
	else
		gui.set_enabled(gui.get_node("backwardarrow"), false)
		gui.set_enabled(gui.get_node("leftarrow"), true)
		gui.set_enabled(gui.get_node("rightarrow"), true)
		gui.set_enabled(gui.get_node("forwardarrow"), true)
	end
end

local arrowTable = {
	"leftarrow",
	"rightarrow",
	"forwardarrow"
}

function on_input(self, action_id, action)
	if onDoor then
		if gui.pick_node(gui.get_node("backwardarrow"), action.x, action.y) then
			if action_id == hash("touch") and action.pressed then
				doors.getCandy()
			end
		end
		if gui.pick_node(gui.get_node("backwardarrow"), action.x, action.y) then
			if action_id == hash("touch") and action.pressed then
				onDoor = false
			end
		end
	else
		for i, v in ipairs(arrowTable) do
			if gui.pick_node(gui.get_node(v), action.x, action.y) then			
				if action_id == hash("touch") and action.pressed then
					if v == "leftarrow" then
						doors.prevDoor()
					elseif v == "rightarrow" then
						doors.nextDoor()
					elseif v == "forwardarrow" then
						onDoor = true
					end
				else

				end
			else

			end
		end
	end
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
