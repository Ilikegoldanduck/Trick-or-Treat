local currCollect = ""

function init(self)
	msg.post(".", "acquire_input_focus")
	msg.post("#doors", "load")
	currCollect = "doors"
end

function on_message(self, message_id, message, sender)
	if message_id == hash("proxy_loaded") then
		msg.post(sender, "enable")
	elseif message_id == hash("proxy_unloaded") then

	end
	if message_id == hash("trick") then
		msg.post("/gui#main", "transition")
		timer.delay(1, false, function()
			if currCollect == "doors" then
				msg.post("#doors", "unload")
			else
				msg.post("#minigame", "unload")
			end
			if message[1] == "doors" then
				msg.post("#doors", "load")
				currCollect = message[1]
			else
				collectionproxy.set_collection("#minigame", "/assets/collectionGrabbers/" .. message[1] .. "/" .. message[1] .. ".collection")
				msg.post("#minigame", "load")
				currCollect = message[1]
			end
		end)
	end
end