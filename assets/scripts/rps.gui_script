local inputs = {
	"rock",
	"paper",
	"scissors"
}

function on_input(self, action_id, action)
	for i, v in ipairs(inputs) do
		if gui.pick_node(gui.get_node(v), action.x, action.y) and action.pressed then
			if action_id == hash(v) and action.pressed then
				msg.post("rps", "play", {choice = v})
			else
				gui.set(gui.get_node(v), "scale", vmath.vector3(1.2, 1.2, 1.2))
			end
		else
			gui.set(gui.get_node(v), "scale", vmath.vector3(1, 1, 1))	
		end
	end
end

